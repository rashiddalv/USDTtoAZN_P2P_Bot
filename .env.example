# ===== Telegram =====
# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Your numeric Telegram user ID (required). Get it from @userinfobot or @getmyid_bot.
# All other users receive "Access denied".
TELEGRAM_ALLOWED_USER_ID=123456789

# ===== Monitoring =====
# Initial minimum rate (AZN per 1 USDT). Can be changed at runtime with /rate.
# The runtime value is persisted in data/state.json and takes priority over this on restart.
MIN_RATE=1.70
# Poll interval in seconds. Values below 30 are clamped to 30 to avoid aggressive polling.
POLL_INTERVAL_SECONDS=45
# How long (hours) to remember an ad after it was last seen, for de-duplication.
NOTIFIED_TTL_HOURS=24
# Max ads to send in one /check reply
CHECK_TOP_N=5

# ===== Binance P2P (no credentials needed) =====
ASSET=USDT
FIAT=AZN
# Request timeout (ms) and retry attempts for the Binance P2P endpoint
BINANCE_TIMEOUT_MS=15000
BINANCE_RETRY_ATTEMPTS=3
# Max pages (20 ads each) fetched per check while ads still match the threshold
BINANCE_MAX_PAGES=3

# ===== Misc =====
DATA_DIR=./data
LOG_LEVEL=info
# Set to "pretty" for human-readable logs in development, "json" for production
LOG_FORMAT=json
TZ=Asia/Baku
